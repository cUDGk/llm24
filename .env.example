# Spotify Developer Dashboard で取得
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# VOICEVOX
VOICEVOX_BASE_URL=http://localhost:50021

# Claude Code SDK (Maxサブスク認証を流用 — 通常は claude login 済みなら不要)
# 必要に応じて ANTHROPIC_API_KEY を設定可能（SDK内部で参照）
ANTHROPIC_API_KEY=

# ffmpeg 実行ファイル（PATHにあれば指定不要）
FFMPEG_BIN=ffmpeg

# サーバ
LLM24_HOST=127.0.0.1
LLM24_PORT=8000
